# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=192.168.1.100
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=events
RABBITMQ_RESULT_QUEUE_PREFIX=results
RABBITMQ_RESULT_TTL_MS=3600000
RABBITMQ_RESULT_QUEUE_EXPIRES_MS=86400000

# 1C Configuration
PATH_1C=C:\Program Files\1cv7
USER_1C=user_api
PASS_1C=password
BRIDGE_VBS=C:\configuration\api\bridge.vbs
TEMP_DIR=C:\configuration\api\logs
CSCRIPT_EXE=C:\WINDOWS\system32\cscript.exe

# Logging
LOG_DIR=C:\configuration\api\logs
LOG_FILE=consumer.log
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=5
